{
  "name": "storyboard",
  "version": "1.0.0",
  "description": "Storyboard Studio — AI-powered cinematic storyboard generator",
  "main": "web/server.js",
  "scripts": {
    "start": "node web/server.js",
    "dev": "node web/server.js",
