{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/(favicon\\.ico|robots\\.txt)", "dest": "/public/$1" },
    { "src": "^/$", "dest": "/public/index.html" },
    { "src": "/influencer$", "dest": "/public/influencer.html" },
    { "src": "/trends$", "dest": "/public/trends.html" },
    { "src": "/flashloop-studio$", "dest": "/public/flashloop-studio.html" },
    { "src": "/effects/([^/]+)$", "dest": "/public/flashloop-studio.html" },
    { "src": "/((?!api/).+\\.[a-zA-Z0-9]+)$", "dest": "/public/$1" }
  ]
}
